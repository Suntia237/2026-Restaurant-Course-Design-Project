/*Table structure for table `order_line_total` */

CREATE VIEW `restaurantjrm`.`order_line_total` AS
SELECT
    order_line.*,
    menu.`price` AS unit_price,
    quantity * menu.`price` AS sub_total
FROM order_line
JOIN menu ON menu.menu_id = order_line.menu_id;

CREATE VIEW `restaurantjrm`.`payment_with_total` AS
SELECT
    p.*,
    COALESCE(SUM(olt.sub_total), 0) AS calculated_total
FROM payment p
LEFT JOIN order_line_total olt ON olt.order_id = p.order_id
GROUP BY p.pay_id, p.order_id, p.pay_method, p.status;